<!DOCTYPE html>
<html lang="pt-BR">
<head>
  <meta charset="UTF-8">
  <meta name="viewport" content="width=device-width, initial-scale=1.0">
  <title>ZKNbet — Criar conta</title>
  <link rel="preconnect" href="https://fonts.googleapis.com">
  <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin>
  <link href="https://fonts.googleapis.com/css2?family=Inter:wght@400;600;700;800&family=Sora:wght@800&display=swap" rel="stylesheet">
  <link rel="preconnect" href="https://zknbet-api.gabrielrobin63.workers.dev" crossorigin>
  <link rel="preconnect" href="https://nitrogames.pladarck.shop" crossorigin>
  <link rel="dns-prefetch" href="https://nitrogames.pladarck.shop">
  <link rel="stylesheet" href="assets/style.css">
  <link rel="stylesheet" href="assets/icons.css">
  <script src="https://challenges.cloudflare.com/turnstile/v0/api.js" async defer></script>
  <script src="https://accounts.google.com/gsi/client" async defer></script>
</head>
<body>
  <header class="zkn-header"><div class="zkn-header-inner"></div></header>

  <div class="auth-wrap">
    <div class="card auth-card">
      <h1>Criar conta</h1>
      <p class="subtitle">Leva menos de 1 minuto.</p>

      <label for="name">Nome completo</label>
      <input type="text" id="name" placeholder="Como quer ser chamado" autocomplete="name">

      <label for="phone">Celular</label>
      <input type="tel" id="phone" placeholder="(11) 91234-5678" inputmode="numeric" autocomplete="tel">

      <label for="email">E-mail</label>
      <input type="email" id="email" placeholder="seu@email.com" autocomplete="email">

      <label for="password">Senha</label>
      <input type="password" id="password" placeholder="Mínimo 6 caracteres" autocomplete="new-password">

      <label for="password2">Confirmar senha</label>
      <input type="password" id="password2" placeholder="Repita a senha" autocomplete="new-password">

      <label for="refCode">Código de indicação (opcional)</label>
      <input type="text" id="refCode" placeholder="Ex: ZKN1A2B3C" maxlength="10">
      <div class="cf-turnstile" data-sitekey="0x4AAAAAAFuJgB2DNgZO7dLw" data-action="register" style="margin-bottom:16px;"></div>

      <div id="g_id_onload"
           data-client_id="643374147618-8cfpb3gkfbl2pi7n4obujbpfdo6haikt.apps.googleusercontent.com"
           data-callback="handleGoogleRegister"
           data-auto_prompt="false"></div>
      <div class="g_id_signin" data-type="standard" data-size="large" data-theme="outline"
           data-text="signup_with" data-shape="rectangular" data-logo_alignment="left"
           style="margin: 16px 0;"></div>
      <div style="display:flex;align-items:center;gap:12px;margin:16px 0;">
        <div style="flex:1;height:1px;background:var(--border);"></div>
        <span style="color:var(--text-muted);font-size:12px;">ou</span>
        <div style="flex:1;height:1px;background:var(--border);"></div>
      </div>
      <button id="btnCadastrar" class="btn-primary btn-block">Criar conta</button>

      <p class="auth-alt">Já tem conta? <a href="login.html">Entrar</a></p>
    </div>
  </div>

  <script src="assets/loading.js"></script>
  <script src="assets/config.js"></script>
  <script src="assets/validators.js"></script>
  <script src="assets/auth.js"></script>
  <script src="assets/app.js"></script>
  <script src="assets/bottom-nav.js"></script>
  <script src="assets/game-frame.js"></script>
  <script>

    window.handleGoogleRegister = async function(response) {
      if (!response || !response.credential) {
        return ZKN.toast('Erro', 'Falha no Google.', 'error');
      }
      const urlRef = new URLSearchParams(location.search).get('ref');
      ZKN.toast('Criando conta...', 'Validando Google');
      const r = await ZKNAuth.loginGoogle({ credential: response.credential, ref: urlRef || undefined });
      if (!r.sucesso) return ZKN.toast('Erro', r.mensagem, 'error');
      ZKN.toast('Conta criada!', 'Bem-vindo à ZKNbet.');
      setTimeout(() => location.href = 'index.html', 600);
    };
    const phoneEl = document.getElementById('phone');
    phoneEl.addEventListener('input', () => window.ZKNVal.mascaraCelular(phoneEl));

    // preenche refCode da URL se vier ?ref=XXXX
    const urlRef = new URLSearchParams(location.search).get('ref');
    if (urlRef) document.getElementById('refCode').value = urlRef.toUpperCase();

    document.getElementById('btnCadastrar').onclick = async () => {
      const name = document.getElementById('name').value.trim();
      const phone = window.ZKNVal.normalizarCelular(phoneEl.value);
      const email = document.getElementById('email').value.trim();
      const password = document.getElementById('password').value;
      const password2 = document.getElementById('password2').value;

      if (!name || name.length < 3) return ZKN.toast('Nome invalido', 'Digite seu nome completo.', 'error');
      if (!window.ZKNVal.validarCelular(phone)) return ZKN.toast('Celular invalido', 'Digite DDD + 9 + 8 digitos.', 'error');
      if (!email || !window.ZKNVal.validarEmail(email)) return ZKN.toast('E-mail invalido', 'Digite um e-mail valido (ex: seu@gmail.com).', 'error');
      if (!password || password.length < 6) return ZKN.toast('Senha muito curta', 'Minimo de 6 caracteres.', 'error');
      if (password !== password2) return ZKN.toast('Senhas nao coincidem', 'Confirme a mesma senha.', 'error');

      const btn = document.getElementById('btnCadastrar');
      btn.disabled = true;
      btn.textContent = 'Criando...';

      const turnstileToken = document.querySelector('.cf-turnstile input[name="cf-turnstile-response"]')?.value || '';

      const r = await ZKNAuth.register({ name, phone, email, password, ref: urlRef || undefined, turnstileToken });

      btn.disabled = false;
      btn.textContent = 'Criar conta';

      if (!r.sucesso) return ZKN.toast('Nao foi possivel cadastrar', r.mensagem, 'error');

      ZKN.toast('Conta criada!', 'Bem-vindo a ZKNbet.');
      setTimeout(() => location.href = 'index.html', 600);
    };
  </script>
</body>
</html>