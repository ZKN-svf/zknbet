<!DOCTYPE html>
<html lang="pt-BR">
<head>
  <meta charset="UTF-8">
  <meta name="viewport" content="width=device-width, initial-scale=1.0">
  <title>ZKNbet - Cassino Online</title>
  <link rel="preconnect" href="https://fonts.googleapis.com">
  <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin>
  <link href="https://fonts.googleapis.com/css2?family=Inter:wght@400;600;700;800&family=Sora:wght@800&display=swap" rel="stylesheet">
  <link rel="preconnect" href="https://zknbet-api.gabrielrobin63.workers.dev" crossorigin>
  <link rel="preconnect" href="https://nitrogames.pladarck.shop" crossorigin>
  <link rel="dns-prefetch" href="https://nitrogames.pladarck.shop">
  <link rel="stylesheet" href="assets/style.css">
</head>
<body class="spa-main">
  <header class="zkn-header"><div class="zkn-header-inner"></div></header>

  <!-- TICKER -->
  <div class="winners-ticker" style="margin-top: 24px;"><div class="winners-track" id="tickerTrack"></div></div>

  <!-- FAVORITOS (so aparece se tiver) -->
  <section class="section" id="favoritosSection" style="display:none;padding-bottom:0;">
    <div class="section-header">
      <h2 class="section-title">Seus favoritos</h2>
      <a href="favoritos.html" class="section-link">Ver todos &rarr;</a>
    </div>
    <div class="games-carousel" id="favoritosGrid"></div>
  </section>

  <!-- RECENTES (so aparece se tiver) -->
  <section class="section" id="recentesSection" style="display:none;padding-bottom:0;">
    <div class="section-header">
      <h2 class="section-title">Jogados recentemente</h2>
      <a href="favoritos.html" class="section-link">Ver favoritos &rarr;</a>
    </div>
    <div class="games-carousel" id="recentesGrid"></div>
  </section>

  <!-- TODOS OS JOGOS (destaque) -->
  <section class="section">
    <div class="section-header">
      <h2 class="section-title">Em destaque</h2>
      <span id="gamesCount" style="color:var(--text-muted);font-size:14px;font-weight:600;"></span>
    </div>

    <div style="position:relative;margin-bottom:20px;max-width:420px;">
      <input type="text" id="busca" placeholder="Buscar jogo..."
             style="width:100%;padding:12px 16px 12px 44px;background:var(--bg-2);border:1px solid var(--border-strong);border-radius:var(--radius-sm);color:var(--text);font-size:14px;outline:none;">
      <span style="position:absolute;left:16px;top:50%;transform:translateY(-50%);color:var(--text-muted);">&#128269;</span>
    </div>

    <div class="games-carousel" id="featuredGrid">
      <div class="game-card" style="grid-column:1/-1;text-align:center;padding:40px;color:var(--text-muted);">Carregando jogos...</div>
    </div>
  </section>

  <!-- PROVEDORAS -->
  <section class="section" style="padding-top:0;">
    <div class="section-header"><h2 class="section-title">Provedoras parceiras</h2></div>
    <div class="providers-strip" id="providersStrip"></div>
  </section>

  <footer class="zkn-footer">
    <div class="zkn-footer-inner">
      <p><strong>ZKNbet</strong> (c) 2026 - Todos os direitos reservados</p>
      <p class="disclaimer">Proibido para menores de 18 anos. Jogue com responsabilidade.</p>
    </div>
  </footer>

  <script src="assets/loading.js"></script>
  <script src="assets/config.js"></script>
  <script src="assets/validators.js"></script>
  <script src="assets/auth.js"></script>
  <script src="assets/app.js"></script>
  <script src="assets/providers-map.js"></script>
  <script src="assets/nitrogames.js"></script>
  <script src="assets/games-lib.js"></script>
  <script>
    // ==========================================================
    // TICKER
    // ==========================================================
    const GAMES_FOR_TICKER = [
      'Fortune Tiger', 'Fortune Ox', 'Gates of Olympus', 'Sweet Bonanza',
      'Big Bass Splash', 'Fortune Rabbit', 'Sugar Rush', 'Wolf Gold',
    ];
    function gerarIdJogador() { return Math.floor(10000 + Math.random() * 90000) + '*****'; }
    function gerarValor() { return 50 + Math.random() * 24950; }
    function gerarWinners(qtd) {
      const arr = [];
      for (let i = 0; i < qtd; i++) arr.push({
        id: gerarIdJogador(),
        game: GAMES_FOR_TICKER[Math.floor(Math.random() * GAMES_FOR_TICKER.length)],
        amount: gerarValor(),
      });
      return arr;
    }
    function renderTicker() {
      const track = document.getElementById('tickerTrack');
      const w = gerarWinners(14);
      const items = [...w, ...w];
      track.innerHTML = items.map(x => `
        <div class="winner-item">
          <span class="winner-name">Jogador ID: ${x.id}</span>
          <span class="winner-game">ganhou</span>
          <span class="winner-amount">${formatBRL(x.amount)}</span>
          <span class="winner-game">em ${x.game}!</span>
        </div>
      `).join('');
    }
    function iniciarTicker() {
      renderTicker();
      setInterval(() => {
        const track = document.getElementById('tickerTrack');
        const x = { id: gerarIdJogador(), game: GAMES_FOR_TICKER[Math.floor(Math.random() * GAMES_FOR_TICKER.length)], amount: gerarValor() };
        const item = document.createElement('div');
        item.className = 'winner-item';
        item.innerHTML = `
          <span class="winner-name">Jogador ID: ${x.id}</span>
          <span class="winner-game">ganhou</span>
          <span class="winner-amount">${formatBRL(x.amount)}</span>
          <span class="winner-game">em ${x.game}!</span>
        `;
        track.appendChild(item);
        if (track.children.length > 30) track.removeChild(track.firstChild);
      }, 25000);
    }

    // ==========================================================
    // JOGOS
    // ==========================================================
    let ALL_GAMES = [];
    let filtro = '';

    function renderCards(containerId, lista) {
      const el = document.getElementById(containerId);
      if (!el) return;

      if (!lista || lista.length === 0) {
        el.innerHTML = '<div class="game-card" style="grid-column:1/-1;text-align:center;padding:40px;color:var(--text-muted);">Nenhum jogo.</div>';
        return;
      }

      el.innerHTML = lista.map(j => {
        const capa = j.image_url || '';
        const inicial = (j.name || '?').charAt(0).toUpperCase();
        const nomeEsc = (j.name || '').replace(/'/g, "\\'");
        const favBtn = window.ZKNGamesLib && window.ZKNGamesLib.renderFavButton ? window.ZKNGamesLib.renderFavButton(j.game_code) : '';
        return `
          <div class="game-card" onclick="jogar('${j.game_code}', '${nomeEsc}')">
            ${favBtn}
            <div class="game-card-cover">
              ${capa ? `<img src="${capa}" alt="${j.name}" loading="lazy" onerror="this.style.display='none';this.parentNode.insertBefore(document.createTextNode('${inicial}'),this.nextSibling)">` : inicial}
              <div class="game-card-play"><div class="play-btn">&#9654;</div></div>
            </div>
            <div class="game-card-info">
              <div class="game-card-name" title="${j.name}">${j.name}</div>
              <div class="game-card-provider">${j.provider_name || ''}</div>
            </div>
          </div>
        `;
      }).join('');
    }    // ==========================================================
    // ORDEM DOS JOGOS FAMOSOS (aparecem primeiro)
    // ==========================================================
    const ORDEM_FAMOSOS = [
      'Fortune Tiger',
      'Fortune Ox',
      'Fortune Rabbit',
      'Fortune Mouse',
      'Fortune Dragon',
      'Gates of Olympus',
      'Sweet Bonanza',
      'Sweet Bonanza Xmas',
      'Sugar Rush',
      'Sugar Rush 1000',
      'Big Bass Bonanza',
      'Big Bass Splash',
      'Big Bass Bonanza - Keeping it Reel',
      'Starlight Princess',
      'The Dog House',
      'Wolf Gold',
      'Wild West Gold',
      'Ganesha Gold',
      'Bikini Paradise',
      'Dragon Tiger Luck',
      'Double Fortune',
      'Jungle Delight',
    ];

    function ordenarFamosos(lista) {
      // Cria um map de prioridade: nome -> índice (menor = mais importante)
      const prioridade = {};
      ORDEM_FAMOSOS.forEach((nome, i) => { prioridade[nome.toLowerCase()] = i; });

      return [...lista].sort((a, b) => {
        const aIdx = prioridade[a.name.toLowerCase()];
        const bIdx = prioridade[b.name.toLowerCase()];
        // Se ambos estão na lista de famosos, ordena por prioridade
        if (aIdx !== undefined && bIdx !== undefined) return aIdx - bIdx;
        // Se só um está, ele vem antes
        if (aIdx !== undefined) return -1;
        if (bIdx !== undefined) return 1;
        // Nenhum é famoso: ordem alfabética
        return a.name.localeCompare(b.name);
      });
    }


    function renderFeatured() {
      const busca = filtro.toLowerCase().trim();
      let lista = ALL_GAMES.filter(g => {
        if (!busca) return true;
        const hay = (g.name + ' ' + (g.provider_name || '')).toLowerCase();
        return hay.includes(busca);
      });

      // Se NAO tem busca: aplica ordem dos famosos
      // Se TEM busca: mantem a ordem original (mais intuitivo pra busca)
      if (!busca) {
        lista = ordenarFamosos(lista);
      }

      document.getElementById('gamesCount').textContent = lista.length + ' jogos';
      renderCards('featuredGrid', lista);
    }

    function renderFavoritosHome() {
      const codes = (window.ZKNGamesLib && ZKNGamesLib.getFavoritos()) || [];
      const section = document.getElementById('favoritosSection');
      const grid = document.getElementById('favoritosGrid');
      if (!codes.length) { section.style.display = 'none'; return; }
      const jogos = codes.map(c => ALL_GAMES.find(j => j.game_code === c)).filter(Boolean).slice(0, 8);
      if (!jogos.length) { section.style.display = 'none'; return; }
      section.style.display = 'block';
      renderCards('favoritosGrid', jogos);
    }

    function renderRecentesHome() {
      const codes = (window.ZKNGamesLib && ZKNGamesLib.getRecentes()) || [];
      const section = document.getElementById('recentesSection');
      const grid = document.getElementById('recentesGrid');
      if (!codes.length) { section.style.display = 'none'; return; }
      const jogos = codes.map(c => ALL_GAMES.find(j => j.game_code === c)).filter(Boolean).slice(0, 8);
      if (!jogos.length) { section.style.display = 'none'; return; }
      section.style.display = 'block';
      renderCards('recentesGrid', jogos);
    }

    async function jogar(code, nome) {
      if (!ZKNAuth.isLoggedIn()) {
        ZKN.toast('Faca login', 'Entre para jogar.', 'warning');
        setTimeout(() => location.href = 'login.html?back=index.html', 800);
        return;
      }
      const user = ZKNAuth.getUser();
      const email = user.email || (user.phone + '@zknbet.com');

      ZKN.toast('Abrindo jogo...', nome || code);
      const res = await NitroGames.abrirJogo(code, email);

      if (res.sucesso && res.launch_url) {
        window.open(res.launch_url, '_blank');
      } else {
        ZKN.toast('Erro ao abrir jogo', res.mensagem || 'Tente novamente.', 'error');
      }
    }

    async function carregarHome() {
      iniciarTicker();

      // OTIMIZADO: paraleliza jogos + provedoras
      const [jogos, provs] = await Promise.all([
        NitroGames.listarJogos(),
        NitroGames.listarProvedores(),
      ]);

      if (jogos.sucesso) {
        ALL_GAMES = window.ZKNProviders ? window.ZKNProviders.aplicarProvidersReais(jogos.jogos || []) : (jogos.jogos || []);
        renderFeatured();
        renderFavoritosHome();
        renderRecentesHome();
      } else {
        document.getElementById('featuredGrid').innerHTML =
          '<div class="game-card" style="grid-column:1/-1;text-align:center;padding:40px;color:var(--red);">' +
          (jogos.mensagem || 'Erro ao carregar jogos.') + '</div>';
      }

      if (provs.sucesso && provs.provedores.length) {
        document.getElementById('providersStrip').innerHTML = provs.provedores.map(p => `
          <div class="provider-chip" onclick="location.href='jogos.html'">${p.name}</div>
        `).join('');
      } else {
        const nomes = window.ZKNProviders ? window.ZKNProviders.providersUnicos(ALL_GAMES) : [...new Set(ALL_GAMES.map(j => j.provider_name).filter(Boolean))];
        document.getElementById('providersStrip').innerHTML = nomes.map(n => `
          <div class="provider-chip" onclick="location.href='jogos.html'">${n}</div>
        `).join('');
      }

      // OTIMIZADO: favoritos + recentes em paralelo
      if (ZKNAuth.isLoggedIn() && window.ZKNGamesLib) {
        await Promise.all([
          ZKNGamesLib.carregarFavoritos(),
          ZKNGamesLib.carregarRecentes(),
        ]);
        renderFavoritosHome();
        renderRecentesHome();
      }
    }

    document.getElementById('busca').addEventListener('input', (e) => {
      filtro = e.target.value;
      renderFeatured();
    });

    window.__FAV_PAGE_RERENDER__ = () => renderFavoritosHome();
    window.__RECENTES_UPDATED__ = () => renderRecentesHome();

    carregarHome();
  </script>
</body>
</html>
