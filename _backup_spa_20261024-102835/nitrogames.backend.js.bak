// ============================================================
// NITROGAMES CLIENT — baseado na doc do projeto Laravel antigo
// Auth: query string (agentToken + secretKey) + body no launch
// ============================================================

const NITRO_BASE_DEFAULT = "https://nitrogames.pladarck.shop";

// ---------- Credenciais no D1 ----------
export async function getCredenciais(env) {
  const row = await env.DB.prepare(
    "SELECT agent_code, agent_token, secret_key, provider_url FROM nitrogames_credentials ORDER BY updated_at DESC LIMIT 1"
  ).first();
  if (!row || !row.agent_token || !row.secret_key) return null;
  return {
    agentCode: row.agent_code || "",
    agentToken: row.agent_token,
    secretKey: row.secret_key,
    providerUrl: (row.provider_url || NITRO_BASE_DEFAULT).replace(/\/+$/, ""),
  };
}

export async function salvarCredenciais(env, { agentCode, agentToken, secretKey, providerUrl }) {
  const id = "nitro_creds";
  const agora = Date.now();
  await env.DB.prepare(
    `INSERT INTO nitrogames_credentials (id, agent_code, agent_token, secret_key, provider_url, paired_at, updated_at)
     VALUES (?, ?, ?, ?, ?, ?, ?)
     ON CONFLICT(id) DO UPDATE SET
       agent_code = excluded.agent_code,
       agent_token = excluded.agent_token,
       secret_key = excluded.secret_key,
       provider_url = excluded.provider_url,
       updated_at = excluded.updated_at`
  ).bind(id, agentCode, agentToken, secretKey, providerUrl, agora, agora).run();
}

// ---------- HTTP base ----------
async function nitroFetch(env, path, options = {}) {
  const creds = await getCredenciais(env);
  if (!creds) return { ok: false, status: 503, data: { msg: "NitroGames nao pareada." } };

  const base = creds.providerUrl || NITRO_BASE_DEFAULT;
  const u = new URL(base + path);
  u.searchParams.set("agentToken", creds.agentToken);
  u.searchParams.set("secretKey", creds.secretKey);

  const res = await fetch(u.toString(), {
    method: options.method || "GET",
    headers: { "Content-Type": "application/json", Accept: "application/json" },
    body: options.body ? JSON.stringify(options.body) : undefined,
  });

  let data = {};
  try { data = await res.json(); } catch { data = {}; }
  return { ok: res.ok, status: res.status, data };
}

// ---------- PAIRING ----------
export async function parear(env, { pairingCode, siteUrl, installationId }) {
  const siteLimpo = (siteUrl || "").replace(/\/+$/, "");
  if (!siteLimpo) return { sucesso: false, mensagem: "site_url obrigatoria" };
  if (!/^NG-[A-Z2-9]{4}-[A-Z2-9]{4}-[A-Z2-9]{4}$/.test(pairingCode)) {
    return { sucesso: false, mensagem: "Codigo de pareamento invalido." };
  }

  const body = {
    pairing_code: pairingCode,
    site_url: siteLimpo,
    callback_base_url: siteLimpo,
    installation_id: installationId,
    platform: "cloudflare-worker",
    version: "1.0.0",
  };

  let res, data = {};
  try {
    res = await fetch(NITRO_BASE_DEFAULT + "/api/v2/integration/pair", {
      method: "POST",
      headers: { "Content-Type": "application/json", Accept: "application/json" },
      body: JSON.stringify(body),
    });
    data = await res.json().catch(() => ({}));
  } catch (e) {
    return { sucesso: false, mensagem: "Falha de conexao: " + e.message };
  }

  if (!res.ok || !data.status || !data.integration?.agent_token || !data.integration?.secret_key) {
    return { sucesso: false, mensagem: data.msg || "Falha ao parear", httpStatus: res.status, raw: data };
  }

  const integration = data.integration;
  await salvarCredenciais(env, {
    agentCode: String(integration.agent_code || ""),
    agentToken: String(integration.agent_token),
    secretKey: String(integration.secret_key),
    providerUrl: String(integration.provider_url || NITRO_BASE_DEFAULT),
  });

  return {
    sucesso: true,
    agent_code: integration.agent_code,
    provider_url: integration.provider_url || NITRO_BASE_DEFAULT,
  };
}

// ---------- GAMES ----------
export async function listarJogos(env) {
  const creds = await getCredenciais(env);
  if (!creds) return { sucesso: false, mensagem: "NitroGames nao pareada." };

  const { ok, data } = await nitroFetch(env, "/api/v2/games");
  if (!ok) return { sucesso: false, mensagem: data.msg || "Erro ao listar jogos" };

  let lista = data.data;
  if (lista && !Array.isArray(lista)) {
    if (Array.isArray(lista.games)) lista = lista.games;
    else if (Array.isArray(lista.items)) lista = lista.items;
    else if (Array.isArray(lista.results)) lista = lista.results;
    else lista = [];
  }
  lista = Array.isArray(lista) ? lista : [];

  const jogos = lista.map((g) => ({
    game_code: String(g.game_code ?? g.code ?? g.id ?? ""),
    name: String(g.name ?? g.title ?? ""),
    provider_name: typeof g.provider === "string" ? g.provider : (g.provider?.name || g.provider_name || ""),
    image_url: (() => {
      const raw = String(g.image_url ?? g.image ?? g.thumbnail ?? "");
      if (raw.startsWith("http")) return raw;
      if (raw.startsWith("/")) return "https://nitrogames.pladarck.shop" + raw;
      return raw;
    })(),
    original: !!(g.original ?? g.is_original),
    rounds_free: !!g.rounds_free,
  })).filter((g) => g.game_code);

  return { sucesso: true, jogos };
}

export async function listarProvedores(env) {
  const { ok, data } = await nitroFetch(env, "/api/v2/providers");
  if (!ok) return { sucesso: false, mensagem: data.msg || "Erro ao listar provedores" };

  let lista = data.data;
  if (lista && !Array.isArray(lista)) {
    if (Array.isArray(lista.providers)) lista = lista.providers;
    else lista = [];
  }
  return {
    sucesso: true,
    provedores: (lista || []).map((p) => ({
      id: p.id,
      name: String(p.name || ""),
      code: String(p.code || ""),
    })),
  };
}

// ---------- LAUNCH ----------
export async function abrirJogo(env, { userCode, gameCode, provider, gameOriginal, userBalance, lang }) {
  const creds = await getCredenciais(env);
  if (!creds) return { sucesso: false, mensagem: "NitroGames nao pareada." };

  const body = {
    agentToken: creds.agentToken,
    secretKey: creds.secretKey,
    user_code: String(userCode || "").trim(),
    game_code: String(gameCode || "").trim(),
    game_original: !!gameOriginal,
    user_balance: Number(userBalance || 0),
    lang: lang || "pt",
  };

  if (provider && String(provider).trim() !== "") {
    body.provider = String(provider).trim();
  }

  const urlLaunch = (creds.providerUrl || NITRO_BASE_DEFAULT) + "/api/v2/game_launch";

  let res, data = {};
  try {
    console.log("[NITRO LAUNCH] Body enviado:", JSON.stringify(body, null, 2));
    res = await fetch(urlLaunch, {
      method: "POST",
      headers: { "Content-Type": "application/json", Accept: "application/json" },
      body: JSON.stringify(body),
    });
    data = await res.json().catch(() => ({}));
    console.log("[NITRO LAUNCH] Status:", res.status, "Resposta:", JSON.stringify(data, null, 2));
  } catch (e) {
    console.log("[NITRO LAUNCH] Erro:", e.message);
    return { sucesso: false, mensagem: "Falha de conexao: " + e.message };
  }

  const okStatus = data.status === true || Number(data.status) === 1;
  if (!res.ok || !okStatus) {
    return { sucesso: false, mensagem: data.msg || "Falha ao abrir jogo", httpStatus: res.status };
  }

  const urlJogo = data.launch_url || data.launchUrl;
  if (!urlJogo) return { sucesso: false, mensagem: "NitroGames nao retornou launch_url" };

  return { sucesso: true, launch_url: urlJogo, name: data.name || null, user_balance: data.user_balance ?? userBalance };
}

// ============================================================
// CONSULTA DE SALDO (para o webhook BALANCE da NitroGames)
// ============================================================
export async function consultarSaldoUsuario(env, userCode) {
  if (!userCode) return { ok: false, balance: 0, mensagem: "user_code obrigatorio" };

  // userCode = email (padrao novo)
  let user = await env.DB.prepare(
    "SELECT uid, balance FROM users WHERE email = ?"
  ).bind(userCode).first();

  // Fallback: {phone}@zknbet.com
  if (!user && userCode.endsWith("@zknbet.com")) {
    const phone = userCode.replace("@zknbet.com", "");
    user = await env.DB.prepare(
      "SELECT uid, balance FROM users WHERE phone = ?"
    ).bind(phone).first();
  }

  // Fallback: u{uid}
  if (!user && /^u/i.test(userCode)) {
    const uid = userCode.replace(/^u/i, "");
    user = await env.DB.prepare(
      "SELECT uid, balance FROM users WHERE uid = ?"
    ).bind(uid).first();
  }

  if (!user) return { ok: false, balance: 0, mensagem: "INVALID_USER" };
  return { ok: true, balance: Number(user.balance || 0), uid: user.uid };
}

// ============================================================
// PROCESSA TRANSACAO (webhook TRANSACTION da NitroGames)
// bet/win sao deltas incrementais. Idempotente por txn_id.
// ============================================================
export async function processarTransacao(env, { userCode, txnId, roundId, gameCode, bet, win }) {
  // 1) Valida entrada
  if (!userCode) return { ok: false, mensagem: "INVALID_USER", balance: 0, httpStatus: 404 };
  if (!txnId || String(txnId).trim() === "") {
    return { ok: false, mensagem: "MISSING_TRANSACTION_ID", balance: 0, httpStatus: 400 };
  }
  const betN = Number(bet || 0);
  const winN = Number(win || 0);
  if (!isFinite(betN) || !isFinite(winN) || betN < 0 || winN < 0) {
    return { ok: false, mensagem: "INVALID_TRANSACTION", balance: 0, httpStatus: 400 };
  }

  // 2) Resolve usuario
  const saldo = await consultarSaldoUsuario(env, userCode);
  if (!saldo.ok) return { ok: false, mensagem: "INVALID_USER", balance: 0, httpStatus: 404 };
  const uid = saldo.uid;

  // 3) Idempotencia
  const existing = await env.DB.prepare(
    "SELECT id, balance_after FROM nitrogames_transactions WHERE txn_id = ?"
  ).bind(String(txnId)).first();
  if (existing) {
    return { ok: true, balance: Number(saldo.balance), duplicate: true, httpStatus: 200 };
  }

  // 4) Saldo insuficiente?
  if (betN > 0 && saldo.balance < betN) {
    return { ok: false, mensagem: "INSUFFICIENT_USER_FUNDS", balance: saldo.balance, httpStatus: 400 };
  }

  // 5) Calcula novo saldo
  const novoSaldo = Math.round((saldo.balance - betN + winN) * 100) / 100;

  // 6) Grava transacao + atualiza saldo (batch atomico)
  const txId = "ng_" + crypto.randomUUID().replace(/-/g, "").slice(0, 16);
  try {
    await env.DB.batch([
      env.DB.prepare("UPDATE users SET balance = balance - ? + ?, total_bet = total_bet + ?, bet_since_deposit = bet_since_deposit + ? WHERE uid = ?").bind(betN, winN, betN, betN, uid),
      env.DB.prepare(
        `INSERT INTO nitrogames_transactions (id, user_uid, txn_id, round_id, game_code, bet, win, balance_after, created_at)
         VALUES (?, ?, ?, ?, ?, ?, ?, ?, ?)`
      ).bind(txId, uid, String(txnId), roundId ? String(roundId) : null, gameCode ? String(gameCode) : null, betN, winN, novoSaldo, Date.now()),
    ]);

    console.log("[NITRO TXN] total_bet += " + betN + " (uid " + uid + ")");

    // Credita owner wallet (lucro da casa) se bet > win
    const lucroCasa = betN - winN;
    if (lucroCasa > 0) {
      try {
        await env.DB.prepare(
          "UPDATE owner_wallet SET balance = balance + ?, updated_at = ? WHERE id = 'main'"
        ).bind(lucroCasa, Date.now()).run();
      } catch (e) {
        console.log("[NITRO TXN] erro ao creditar owner wallet:", e.message);
      }
    }

    // Se o saldo ficou <= 0, zera o rollover (nao faz sentido manter)
    if (novoSaldo <= 0) {
      try {
        // Zera deposited + bet_since_deposit (rollover reseta)
        // MAS mantem total_deposited + total_bet (historico)
        await env.DB.prepare(
          "UPDATE users SET deposited = 0, bet_since_deposit = 0 WHERE uid = ?"
        ).bind(uid).run();
        console.log("[NITRO TXN] saldo zerado, deposited/bet_since_deposit resetados para uid:", uid);
      } catch (e) {
        console.log("[NITRO TXN] erro ao resetar deposited:", e.message);
      }
    }
  } catch (e) {
    console.log("[NITRO TXN] erro:", e.message);
    return { ok: false, mensagem: "ERROR_INTERNAL", balance: saldo.balance, httpStatus: 500 };
  }

  return { ok: true, balance: novoSaldo, bet: betN, win: winN, httpStatus: 200 };
}